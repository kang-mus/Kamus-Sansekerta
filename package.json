{
  "name": "kata-sansekerta",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "sync:public": "bun -e \"await Bun.write('public/data/kamus.json', await Bun.file('data/kamus.json').text()); await Bun.write('public/data/meta.json', await Bun.file('data/meta.json').text()); console.log('synced public/data')\"",
    "build": "bun run sync:public && vite build",
    "preview": "vite preview --port 4173",
    "scrape:wiktionary": "bun run scripts/scrape-wiktionary.ts",
    "scrape:kbji": "bun run scripts/scrape-kbji.ts",
    "scrape:kbji:resume": "bun run scripts/scrape-kbji.ts --resume",
    "merge": "bun run scripts/merge.ts",
    "scrape:all": "bun run scrape:wiktionary && bun run merge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
